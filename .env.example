APP_ENV=development
APP_NAME=adaptive-rag-cs
LOG_LEVEL=DEBUG
API_V1_PREFIX=/api/v1
# 知识库目录：启动时全量 ingest 该目录下的文档。
KNOWLEDGE_DIR=knowledge

# LLM：任意 OpenAI 兼容接口。本版本默认用硅基流动 (SiliconFlow) 上的 DeepSeek V4.1 Flash；
# 换回 DeepSeek 官方接口时改成 https://api.deepseek.com 和 deepseek-chat，并注释掉 LLM_ENABLE_THINKING。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.siliconflow.cn/v1
DEEPSEEK_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3
# 思考模式开关，对应硅基流动的 enable_thinking 参数；不设置就不传，由服务商默认决定。
# V4.1 Flash 这类混合思考模型默认开启思考，设为 false 可明显降低延迟。
LLM_ENABLE_THINKING=false

# Dense retrieval: local BAAI/bge-small-zh-v1.5 (~90MB).
# Remote OpenAI-compatible API wins if both KEY and BASE_URL are set.
# APP_ENV=testing skips the model unless LOCAL_EMBEDDING_FORCE=true.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=bge-small-zh-v1.5
EMBEDDING_DIM=512
LOCAL_EMBEDDING_ENABLED=true
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
LOCAL_EMBEDDING_DEVICE=
LOCAL_EMBEDDING_FORCE=false

# Rerank: local Cross-Encoder (BAAI/bge-reranker-base).
# pip install -e ".[rerank]"  then the first request downloads weights.
# APP_ENV=testing skips the model unless CROSS_ENCODER_FORCE=true.
CROSS_ENCODER_ENABLED=true
CROSS_ENCODER_MODEL=BAAI/bge-reranker-base
CROSS_ENCODER_DEVICE=
CROSS_ENCODER_MAX_LENGTH=512
CROSS_ENCODER_FORCE=false
# Hugging Face 在国内常超时；sentence-transformers 认这个镜像变量。
HF_ENDPOINT=https://hf-mirror.com

# Document ingest: Unstructured for PDF/Office/HTML/images. Markdown heading
# split is the fallback when the extra is missing or APP_ENV=testing.
# pip install -e ".[docs]"  plus system packages: poppler, tesseract+chi_sim,
# libreoffice (for DOCX/PPTX).
UNSTRUCTURED_ENABLED=true
UNSTRUCTURED_STRATEGY=auto
UNSTRUCTURED_OCR_LANGUAGES=chi_sim+eng
UNSTRUCTURED_FORCE=false

# MCP: local tools are registered by default; set a URL to add a remote HTTP tool.
MCP_ENABLED=true
MCP_REMOTE_URL=

# Persistence: local quick start uses SQLite and in-process fallbacks.
# docker compose overrides these with Postgres, Redis and Qdrant URLs.
DATABASE_URL=sqlite+aiosqlite:///./data/local/app.db
REDIS_URL=
QDRANT_URL=
QDRANT_COLLECTION=cs_knowledge

# Retrieval
RETRIEVAL_TOP_K_SIMPLE=3
RETRIEVAL_TOP_K_COMPLEX=8
RRF_K=60
RERANK_TOP_N=5
MAX_RETRIEVAL_HOPS=3

# Memory
TOKEN_BUDGET=128000
COMPRESS_SOFT_RATIO=0.50
COMPRESS_HARD_RATIO=0.70
AUTO_COMPACT_RATIO=0.85
# 多轮记忆：最近几轮对话用于指代消解（查询改写）和回答生成；false = 退回原来的单轮行为（对比实验用）
MEMORY_CONTEXT_ENABLED=true
MEMORY_CONTEXT_TURNS=3
# 意图覆盖层（关键词规则纠偏）：独立测试集上会把模型准确率从 96.9% 拉低到 88.8%，默认关闭；离线模式始终保留
INTENT_OVERLAY_ENABLED=false

# Agent
MAX_AGENT_STEPS=8
MAX_TOOL_CALLS=6

# Rate limit / cache / admin
RATE_LIMIT_PER_MINUTE=60
RETRIEVAL_CACHE_TTL_SECONDS=60
ADMIN_API_TOKEN=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
